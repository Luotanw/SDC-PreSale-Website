# ─────────────────────────────────────────────────────────────────────────
# Order storage (server/index.js)
# ─────────────────────────────────────────────────────────────────────────
# Orders submitted on the site are POSTed to a small Node server, which stores
# each one. Two backends are supported, picked automatically:
#
#   • No Google vars set  → orders are appended to a local CSV file (dev).
#   • GOOGLE_SHEET_ID set  → orders are written to a Google Sheet (production).
#
# Nothing here is required to run locally — these are all optional.

# ── Local CSV backend (development) ──────────────────────────────────────
# Where the server saves orders (default: ./orders.csv in the project root).
# ORDERS_CSV=/Users/you/Desktop/sdc-orders.csv

# Port the order server listens on (default: 3001).
# PORT=3001

# Secret used to sign order-edit tokens. Production requires at least 32 random
# characters. Generate one with: openssl rand -base64 32
# ORDER_EDIT_SECRET=

# Set to 1 when exactly one trusted reverse proxy (such as Render) sits in front
# of Express. Leave unset for direct local development.
# TRUST_PROXY=1

# ── Google Sheets backend (production / free hosting) ────────────────────
# Set these to store orders in a Google Sheet instead of a local file.
# GOOGLE_SHEET_ID is the long token in the sheet's URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
# GOOGLE_SHEET_ID=

# The full service-account JSON key, pasted as a single line/value. The service
# account's client_email must be given Editor access to the sheet.
# GOOGLE_CREDENTIALS={"type":"service_account", ... }

# Worksheet/tab name to write to (default: Orders).
# GOOGLE_SHEET_TAB=Orders

# ── Abuse prevention (recommended for every public deployment) ─────────────
# Create a Cloudflare Turnstile widget for the production hostname, then set
# both values. The API requires verification whenever the secret is configured.
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────
# Where the site sends orders. Defaults to /api/order, which works in dev
# (Vite proxy) and in production (same server serves both). Only set this if
# you run the server on a different host/port.
# VITE_ORDER_ENDPOINT=http://localhost:3001/api/order
# VITE_STATS_ENDPOINT=http://localhost:3001/api/stats
